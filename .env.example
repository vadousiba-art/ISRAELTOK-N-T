# ─────────────────────────────────────────────────────────────────────────────
# YORU — environment
# Copy to .env.local and fill in. With nothing set, `npm run dev` runs in DEMO
# MODE (embedded Postgres in .data/, no passwords, local only).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). Setting the URL + anon key switches the
# app from demo mode to the real backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for invite sign-ups, signed upload URLs and the AI Menace
# bot account. NEVER prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Seven Supabase projects (docs/seven-projects.md) ─────────────────────────
# The original project above stays project 7 (Auth + all data). Projects 1-6
# share live updates and, with a secret key, new uploads.
# SUPABASE_PROJECT_1_URL=https://<ref>.supabase.co
# SUPABASE_PROJECT_1_PUBLISHABLE_KEY=
# SUPABASE_PROJECT_1_SECRET_KEY=        # server-only, enables storage in project 1
# ... same for 2-6
# Spread live updates over the projects (apply migration 0006 to the original first).
# REALTIME_SHARDS=on
# REALTIME_TOPIC_SECRET=                # optional, server-only
# STORAGE_UPLOAD_PROJECTS=1,2,3,4,5,6,7  # optional

# ── Primary database: Neon (optional, off by default) ───────────────────────
# Keeps app data on Neon Postgres while Supabase keeps login, files and
# realtime delivery. Only switches when DATA_BACKEND=neon is set, so a
# DATABASE_URL added by a Vercel integration never changes production by
# itself. Read docs/database-migration.md before turning this on.
# DATA_BACKEND=neon
# Pooled connection string (host contains "-pooler"), used by the app. Server-only.
# DATABASE_URL=
# Direct (non-pooled) connection string, used only by `npm run db:migrate` / `db:copy`.
# DATABASE_URL_DIRECT=
# Supabase database connection string, used only by `npm run db:copy` (read-only).
# SOURCE_DATABASE_URL=
# Optional tuning: connections per server instance (default 5), statement timeout (ms).
# PG_POOL_MAX=5
# PG_STATEMENT_TIMEOUT_MS=15000

# ── Scheduled jobs and health ────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes. Also unlocks
# the database check on /api/health. Any long random string. Server-only.
CRON_SECRET=
# Abandoned-upload cleanup (daily). "report" (default) only counts; "delete" removes
# unreferenced uploads older than UPLOAD_CLEANUP_MIN_AGE_HOURS (default 48).
# UPLOAD_CLEANUP_MODE=report
# UPLOAD_CLEANUP_MIN_AGE_HOURS=48

# AI Menace (server-only). Without it the Menace runs as "Menace Lite"
# (offline joke templates) so every AI button still works.
ANTHROPIC_API_KEY=
# Optional model override. Default: claude-opus-5-5
ANTHROPIC_MODEL=
# Usage limits per member
AI_DAILY_LIMIT_PER_USER=40
AI_BURST_LIMIT_PER_MINUTE=6

# Atlas, the co-founder's assistant (/atlas). Server-only keys; never prefix
# them with NEXT_PUBLIC_. Without GEMINI_API_KEY, voice and images are off;
# without OPENROUTER_API_KEY, only Gemini is offered. See docs/atlas.md.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: Gemini models to use, first is the default, the rest are fallbacks
# when it's overloaded. Default: gemini-3.5-flash,gemini-flash-lite-latest
GEMINI_MODEL=
# Usage limits per member
ATLAS_LIMIT_PER_MINUTE=8
ATLAS_LIMIT_PER_DAY=100

# Push notifications (Web Push). Generate once: npx web-push generate-vapid-keys
# The public key is safe to share; the private key is server-only. Without
# them, YORU works as before and the "turn on notifications" card stays hidden.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:). Default: the site URL.
VAPID_SUBJECT=
# Optional: instant notifications in the Android app (docs/notifications.md).
# Without these the app checks for new notifications in the background.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_ANDROID_APP_ID=
FIREBASE_API_KEY=

# Demo mode controls. Demo is on automatically in development when Supabase
# is not configured. In production it is OFF unless DEMO_MODE=true — demo mode
# lets anyone log in as anyone, so never expose it publicly.
# DEMO_MODE=true
# DEMO_DATA_DIR=.data

# Optional: password for accounts created by `npm run seed` (random if unset)
# SEED_PASSWORD=

# Optional: public support email shown on /privacy and /support
SUPPORT_EMAIL=

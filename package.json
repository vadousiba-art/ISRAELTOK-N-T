  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "seed": "tsx scripts/seed-supabase.ts",
    "db:local": "bash scripts/db/local-postgres.sh",
    "db:migrate": "tsx scripts/db/migrate.mts",
